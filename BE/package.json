{
  "name": "mobile-shop-backend",
  "version": "1.0.0",
  "description": "Backend REST API for Multi-Tenant Mobile Phone Shop Inventory Management & POS",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:seed": "tsx src/database/seed.ts",
    "db:init": "npm run db:migrate && npm run db:seed",
    "test:auth": "tsx src/tests/auth-tenancy.test.ts",
    "test:inventory": "tsx src/tests/inventory-purchasing.test.ts",
    "test:pos": "tsx src/tests/pos-sales.test.ts",
    "test:reports": "tsx src/tests/reports-analytics.test.ts",
    "test:session": "tsx src/tests/session-expiration.test.ts",
    "test:search": "tsx src/tests/global-search.test.ts",
    "test:validation": "tsx src/tests/validation-formatting.test.ts",
    "test:all": "npm run test:auth && npm run test:inventory && npm run test:pos && npm run test:reports && npm run test:session && npm run test:search && npm run test:validation"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.13.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
